# OneCrew 服务端配置模板 —— 复制为 .env 后填写（密钥绝不进前端、绝不提交仓库）
# LLM 走 OpenAI 兼容接口；留空则自动进入内置演示模式（MockProvider）
LLM_BASE_URL=https://api.b.ai/v1
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash
# 备用模型（主模型失败时自动尝试一次）
LLM_FALLBACK_MODEL=qwen3.8-flash

# ---------- v2 媒体层（全部可选：不配则自动降级本地演示模式，全流程不中断） ----------
# 文生图：火山方舟 Seedream 4.0（约 0.2 元/张 2K，OpenAI 兼容）
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_IMAGE_MODEL=doubao-seedream-4-0-250828
# 备选文生图 + TTS 兜底：硅基流动（Kolors 免费 / CosyVoice2 0.5元/万字符）
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
# TTS 高配：MiniMax speech-02-turbo（约 2 元/万字符）
MINIMAX_API_KEY=
PORT=8787
